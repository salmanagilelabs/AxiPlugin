 1ï¸âƒ£ First try hlink_params             if (item.hlink_params) {                 const match = item.hlink_params.match(pattern);                 if (match) return match[0];             }             // 2ï¸âƒ£ Try displaytitle             if (item.displaytitle) {                 const match = item.displaytitle.match(pattern);                 if (match) return match[0];             }             // 3ï¸âƒ£ Try displaycontent             if (item.displaycontent) {                 const match = item.displaycontent.match(pattern);                 if (match) return match[0];             }             if (item.taskid) {                 return item.taskid             }             return null;         }       </script>                                 </body></html> "
